# Database Configuration
POSTGRES_USER=modelisys
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=modelisys
DATABASE_URL=postgresql://modelisys:your_secure_password_here@db:5432/modelisys

# JWT Configuration
# IMPORTANT: Generate a secure key for production with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma-separated list of allowed origins
# Example for production: https://app.modelisys.com,https://www.modelisys.com
CORS_ORIGINS=http://localhost:3000

# App
DEBUG=false
# Environment: development, staging, production
# In production, JWT_SECRET_KEY validation is enforced
ENVIRONMENT=development

# Email (optional — required for password reset and notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# FROM_EMAIL=noreply@your-domain.com

# QuickBooks Online integration (sandbox dev)
# Get client ID/secret from https://developer.intuit.com (Sandbox app)
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_ENVIRONMENT=sandbox
INTUIT_REDIRECT_URI=http://localhost:8000/api/quickbooks/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QBO_TOKEN_ENCRYPTION_KEY=
