# Database Configuration
# PostgreSQL connection settings
POSTGRES_USER=modelisys
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=modelisys

# Full database URL (used by backend)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://modelisys:your_secure_password_here@db:5432/modelisys

# Authentication
# JWT secret key - MUST be changed in production
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here

# Optional: JWT token expiration (in minutes)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Environment
# NODE_ENV=production
# PYTHON_ENV=production

# Optional: Frontend URL (for CORS)
# FRONTEND_URL=https://your-domain.com

# Optional: Sentry DSN (error monitoring)
# SENTRY_DSN=https://your-sentry-dsn

# Optional: Rate limiting (requests per minute)
# RATE_LIMIT_PER_MINUTE=60

# Optional: Email service (for password reset, notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# FROM_EMAIL=noreply@your-domain.com
